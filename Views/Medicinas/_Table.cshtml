@model IEnumerable<SistemaMedicamentos.Models.Medicina>
<table class="table table-striped table-bordered table-flat">
    <thead>
        <tr>
            <th>Medicina</th>
            <th>Laboratorio</th>
            <th>Stock</th>
            <th>Vencimiento</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Nombre @(m.RequiereReceta ? "(receta)" : "")</td>
                <td>@m.Laboratorio</td>
                <td>@m.Stock</td>
                <td>@m.FechaVencimiento.ToString("dd/MM/yyyy") @(m.Vencida ? "(vencida)" : "")</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-flat-primary">Ver</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-flat-red">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
