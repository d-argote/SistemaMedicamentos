@model SistemaMedicamentos.Models.Sede
@{
    ViewData["Title"] = "Eliminar sede";
}
<div class="card-flat">
    <div class="card-header-flat">Eliminar sede</div>
    <div class="card-body-flat">
        <p>¿Eliminar la sede <strong>@Model.Nombre</strong> (@Model.Ciudad)?</p>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-flat-red">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
