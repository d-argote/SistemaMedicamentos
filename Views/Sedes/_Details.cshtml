@model SistemaMedicamentos.Models.Sede
<dl class="row">
    <dt class="col-sm-3">Sede</dt><dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Dirección</dt><dd class="col-sm-9">@Model.Direccion</dd>
    <dt class="col-sm-3">Ciudad</dt><dd class="col-sm-9">@Model.Ciudad</dd>
    <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@Model.Telefono</dd>
    <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.Activa ? "Activa" : "Inactiva")</dd>
</dl>
@if (Model.Entregas.Any())
{
    <h6>Entregas atendidas en esta sede</h6>
    <ul>
        @foreach (var e in Model.Entregas)
        {
            <li>@e.FechaEntrega.ToString("dd/MM/yyyy") — @e.Paciente?.NombreCompleto: @e.Medicina?.Nombre x @e.Cantidad (@e.Estado)</li>
        }
    </ul>
}
