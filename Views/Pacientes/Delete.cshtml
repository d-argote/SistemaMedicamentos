@model SistemaMedicamentos.Models.Paciente
@{
    ViewData["Title"] = "Eliminar paciente";
}
<div class="card-flat">
    <div class="card-header-flat">Eliminar paciente</div>
    <div class="card-body-flat">
        <p>¿Eliminar al paciente <strong>@Model.NombreCompleto</strong> (Cédula @Model.Dni)?</p>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-flat-red">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
