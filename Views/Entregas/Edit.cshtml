@model SistemaMedicamentos.Models.Entrega
@{
    ViewData["Title"] = "Editar entrega";
}
<div class="card-flat">
    <div class="card-header-flat">Editar entrega</div>
    <div class="card-body-flat">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ComprobantePath" />
            <input type="hidden" asp-for="UserId" />
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-flat-green">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
